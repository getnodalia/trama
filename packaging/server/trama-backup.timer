# Runs trama-backup.service every night (see that file).
#   sudo systemctl enable --now trama-backup.timer
#   systemctl list-timers trama-backup.timer

[Unit]
Description=Nightly backup of trama-server's data directory

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
