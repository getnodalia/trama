<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="Trama" Manufacturer="Nodalia" Version="$(var.Version)" UpgradeCode="33A433A8-CFE1-4969-ACAD-171AAB11DE3E" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Trama interface design and prototyping tool" Manufacturer="Nodalia" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Trama is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="TramaIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="TramaIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://getnodalia.com/trama" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getnodalia.com/trama" />
    <Property Id="ARPHELPLINK" Value="https://github.com/getnodalia/trama/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Nodalia">
        <Directory Id="INSTALLFOLDER" Name="Trama" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by TramaApp). -->

    <Feature Id="Main" Title="Trama" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="TramaFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchTrama" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through trama.en-us.wxl. -->
    <Property Id="TramaVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Trama $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Trama" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#TramaExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchTrama" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="TramaFiles" Directory="INSTALLFOLDER">
      <Component Id="TramaApp" Guid="134AF699-C4C0-4398-AC50-E2AD3606A7B5">
        <File Id="TramaNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="TramaExe" Source="$(var.BinDir)\trama.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Trama" Description="Trama interface design and prototyping" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="TramaIcon.exe" IconIndex="0" />
        </File>

        <!-- .trama: Trama's own format; Trama is its default app. -->
        <ProgId Id="Trama.Document" Description="Trama Document" Icon="TramaExe" IconIndex="0">
          <Extension Id="trama" ContentType="application/x-trama">
            <Verb Id="open" Command="Open" TargetFile="TramaExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- SVG and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="Trama.Image" Description="Image" Icon="TramaExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Trama.Image\shell\open\command" Value="&quot;[#TramaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.svg\OpenWithProgids" Name="Trama.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="Trama.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpg\OpenWithProgids" Name="Trama.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Trama.Image" Value="" Type="string" />
        <!-- Sketch files (opened as a copy; Trama doesn't save .sketch): "Open with" only too. -->
        <ProgId Id="Trama.Sketch" Description="Sketch Document" Icon="TramaExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Trama.Sketch\shell\open\command" Value="&quot;[#TramaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.sketch\OpenWithProgids" Name="Trama.Sketch" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "trama"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\trama.exe" Name="FriendlyAppName" Value="Trama" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\trama.exe\shell\open\command" Value="&quot;[#TramaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\trama.exe\SupportedTypes" Name=".trama" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\trama.exe\SupportedTypes" Name=".svg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\trama.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\trama.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\trama.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\trama.exe\SupportedTypes" Name=".sketch" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\trama.exe" Value="[#TramaExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Trama" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="TramaCli">
        <File Id="TramaCliExe" Source="$(var.BinDir)\trama-cli.exe" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
